{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowCreateBucketForAsistenciaCenerisMedia",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket"
            ],
            "Resource": [
                "arn:aws:s3:::asistencia-ceneris-media",
                "arn:aws:s3:::*"
            ]
        },
        {
            "Sid": "AllowS3ObjectActionsForAsistenciaCenerisMedia",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::asistencia-ceneris-media",
                "arn:aws:s3:::asistencia-ceneris-media/*"
            ]
        }
    ]
}
