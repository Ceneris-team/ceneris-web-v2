# ============================================
# CONFIGURACIÓN CENERIS WEB - PLANTILLA
# ============================================
# Copia este archivo como .env y configura tus valores
# NO subir .env a Git (ya está en .gitignore)

# ============================================
# DJANGO - CONFIGURACIÓN BÁSICA (REQUERIDO)
# ============================================

# Clave secreta de Django (GENERAR UNA NUEVA para producción)
SECRET_KEY=django-insecure-tu-clave-local-de-desarrollo

# Modo debug (True para desarrollo, False para producción)
DJANGO_DEBUG=True

# Base de datos
# Para desarrollo: sqlite:///db.sqlite3
# Para producción PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# ============================================
# FIREBASE / FIRESTORE (OPCIONAL)
# ============================================

# Usar Firestore como base de datos (true/false)
USE_FIRESTORE=False

# Credenciales de Firebase (solo si USE_FIRESTORE=true)
# FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# ============================================
# AWS S3 - ALMACENAMIENTO DE ARCHIVOS (OPCIONAL)
# ============================================

# Sin estas credenciales, los archivos se guardan localmente en media/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=asistencia-ceneris-media
# AWS_S3_REGION_NAME=us-east-1

# ============================================
# EMAIL - SENDGRID (OPCIONAL)
# ============================================

# API Key de SendGrid para envío de correos
# SENDGRID_API_KEY=

# ============================================
# CLAVES ADICIONALES (OPCIONAL)
# ============================================

# Clave para formularios de Google
# GOOGLE_FORM_SECRET_KEY=

# Clave para trabajos cron
# CRON_SECRET_KEY=

# URL de PostgreSQL para el script scripts/migrar_a_firebase.py
# (si no se define, se usa DATABASE_URL). No commitear valores reales.
# POSTGRES_MIGRATION_URL=

# ============================================
# SUPERUSUARIO DJANGO (OPCIONAL)
# ============================================

# Crear superusuario automáticamente en deploy
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@ceneris.com
# DJANGO_SUPERUSER_PASSWORD=admin123

# ============================================
# MONITOREO-WEB — CORTE (OPCIONAL, Fase 4)
# ============================================

# Solo configurar cuando monitoreo-web esté desplegado y verificado.
# Sin esta variable, el login de Proyecto_Yeni/Yeni_admin sigue
# funcionando igual que hoy (dentro de este repo).
# MONITOREO_WEB_URL=https://monitoreo-web.onrender.com/dashboard/

# ============================================
# NOTAS:
# ============================================
# ✓ Para desarrollo local: solo necesitas SECRET_KEY, DJANGO_DEBUG y DATABASE_URL
# ✓ USE_FIRESTORE=False y sin AWS_* = archivos se guardan localmente
# ✓ Para producción: configurar todos los valores necesarios
# ============================================
